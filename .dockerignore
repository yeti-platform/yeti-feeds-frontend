# docker/prod/Dockerfile uses `ADD . /app` in its builder stage, so anything not
# excluded here is copied into that stage. `.git` in particular carries the
# credentials actions/checkout writes into .git/config. The final image only
# copies /app/dist, so this never reached the published image -- but it should
# not be in the build at all, and a future single-stage refactor would expose it.
.git
.github
.gitignore

# Local secrets and environment.
.env
.env.*

# Installed fresh by `npm install` inside the builder; copying the host's copy
# in is slow and can carry host-specific native binaries.
node_modules

# Build and test output, regenerated by `npm run build`.
dist
playwright-report
test-results
